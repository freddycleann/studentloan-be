# Server
PORT=4000
NODE_ENV=development

# CORS - your frontend URL
FRONTEND_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=30d

# Seed admin (only used on first run if no users exist)
SEED_ADMIN_USERNAME=freddyclean
SEED_ADMIN_PASSWORD=bobozaza55

# SQLite file location (relative to backend dir)
DB_FILE=./data/app.db

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=student-loan
